datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Status {
  ACTIVE
  INACTIVE
}

enum PricingType {
  FIXED
  PER_UNIT
}

enum BillingCycle {
  ONE_TIME
  MONTHLY
}

enum QuestionType {
  RADIO
  CHECKBOX
  SELECT
  COUNTER
  NUMBER
  TEXT
  TOGGLE
}

enum ModifierType {
  FLAT
  MULTIPLIER
}

enum MultiplierCategory {
  COMPLEXITY
  URGENCY
  QUALITY
}

enum EstimateStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum EnquiryStatus {
  PENDING
  CONTACTED
  COMPLETED
  ARCHIVED
}

enum AdminRole {
  ADMIN
}

model AdminAccount {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  name         String
  role         AdminRole  @default(ADMIN)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  auditLogs    AuditLog[]
}

model Service {
  id          String             @id
  name        String
  category    String
  description String
  iconName    String
  iconImage   String?
  cardImage   String?
  heroBanner  String?
  thumbnail   String?
  basePrice   Decimal            @db.Decimal(12, 2)
  unitType    String
  status      Status             @default(ACTIVE)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  questions   Question[]
  components  PricingComponent[]
  packages    Package[]
  faqs        FAQItem[]
}

model FAQItem {
  id           String   @id @default(uuid())
  serviceId    String
  service      Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  question     String
  answer       String
  displayOrder Int      @default(0)
  status       Status   @default(ACTIVE)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Package {
  id            String           @id
  serviceId     String
  service       Service          @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  name          String
  price         Decimal          @db.Decimal(12, 2)
  timeline      String
  description   String
  isRecommended Boolean          @default(false)
  isPopular     Boolean          @default(false)
  isBestValue   Boolean          @default(false)
  isNew         Boolean          @default(false)
  displayOrder  Int              @default(0)
  status        Status           @default(ACTIVE)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  features      PackageFeature[]
  questions     Question[]
}

model PackageFeature {
  id        String   @id @default(uuid())
  packageId String
  package   Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  feature   String
  createdAt DateTime @default(now())
}

model PricingComponent {
  id           String       @id
  serviceId    String
  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  name         String
  pricingType  PricingType  @default(FIXED)
  price        Decimal      @db.Decimal(12, 2)
  description  String
  maxQuantity  Int?
  iconName     String?
  status       Status       @default(ACTIVE)
  category     String
  billingCycle BillingCycle @default(ONE_TIME)
  note         String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Question {
  id                     String           @id
  serviceId              String?
  service                Service?         @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  packageId              String?
  package                Package?         @relation(fields: [packageId], references: [id], onDelete: Cascade)
  text                   String
  description            String?
  type                   QuestionType
  isRequired             Boolean          @default(true)
  displayOrder           Int              @default(0)
  defaultValue           Json?
  priceModifier          Decimal          @db.Decimal(12, 2)
  modifierType           ModifierType     @default(FLAT)
  conditionalParentId    String?
  conditionalParentValue String?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  options                QuestionOption[]
  validationRule         ValidationRule?
}

model QuestionOption {
  id            String       @id @default(uuid())
  questionId    String
  question      Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  value         String
  label         String
  priceModifier Decimal      @db.Decimal(12, 2)
  modifierType  ModifierType @default(FLAT)
  description   String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([questionId, value])
}

model ValidationRule {
  id         String   @id @default(uuid())
  questionId String   @unique
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  min        Int?
  max        Int?
  pattern    String?
  message    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Multiplier {
  id          String             @id
  category    MultiplierCategory
  label       String
  value       Decimal            @db.Decimal(5, 2)
  description String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model Estimate {
  id                   String                    @id
  enquiryId            String?                   @unique
  enquiry              Enquiry?                  @relation(fields: [enquiryId], references: [id], onDelete: SetNull)
  customerName         String
  customerEmail        String
  customerPhone        String?
  customerCompany      String?
  notes                String?
  subtotal             Decimal                   @db.Decimal(12, 2)
  totalPrice           Decimal                   @db.Decimal(12, 2)
  taxRateSnapshot      Decimal                   @db.Decimal(5, 2)
  taxAmount            Decimal                   @db.Decimal(12, 2)
  discountRateSnapshot Decimal                   @db.Decimal(5, 2)
  discountAmount       Decimal                   @db.Decimal(12, 2)
  currency             String                    @default("₹")
  validUntil           DateTime?
  status               EstimateStatus            @default(PENDING)
  createdDate          DateTime                  @default(now())
  breakdown            Json
  answers              Json
  estimateRange        String?
  updatedAt            DateTime                  @updatedAt
  selectedServices     SelectedEstimateService[]
}

model SelectedEstimateService {
  id                String                  @id @default(uuid())
  estimateId        String
  estimate          Estimate                @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  serviceId         String
  serviceName       String
  baseCost          Decimal                 @db.Decimal(12, 2)
  addonsCost        Decimal                 @db.Decimal(12, 2)
  multiplierProduct Decimal                 @db.Decimal(5, 2)
  totalCost         Decimal                 @db.Decimal(12, 2)
  estimatedTimeline String
  selectedPackage   SelectedPackage?
  selectedAddons    SelectedEstimateAddon[]
}

model SelectedPackage {
  id                        String                  @id @default(uuid())
  selectedEstimateServiceId String                  @unique
  selectedEstimateService   SelectedEstimateService @relation(fields: [selectedEstimateServiceId], references: [id], onDelete: Cascade)
  packageId                 String
  name                      String
  price                     Decimal                 @db.Decimal(12, 2)
  timeline                  String
}

model SelectedEstimateAddon {
  id                        String                  @id @default(uuid())
  selectedEstimateServiceId String
  selectedEstimateService   SelectedEstimateService @relation(fields: [selectedEstimateServiceId], references: [id], onDelete: Cascade)
  pricingComponentId        String
  name                      String
  pricingType               PricingType
  price                     Decimal                 @db.Decimal(12, 2)
  quantity                  Int                     @default(1)
  billingCycle              BillingCycle            @default(ONE_TIME)
}

model Enquiry {
  id               String        @id
  name             String
  email            String
  phone            String
  company          String?
  estimateRange    String
  message          String
  status           EnquiryStatus @default(PENDING)
  createdDate      DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  selectedServices String[]
  estimate         Estimate?
}

model GlobalSettings {
  id                       String   @id @default("default")
  companyName              String
  currency                 String   @default("₹")
  taxRate                  Decimal  @db.Decimal(5, 2)
  discountRate             Decimal  @db.Decimal(5, 2)
  defaultPricingMode       String
  minimumCost              Decimal  @db.Decimal(12, 2)
  maximumCost              Decimal  @db.Decimal(12, 2)
  whatsappNumber           String?
  gateEstimateWithLeadForm Boolean  @default(false)
  updatedAt                DateTime @updatedAt
}

model AuditLog {
  id             String        @id @default(uuid())
  action         String
  entityType     String
  entityId       String
  adminAccountId String?
  adminAccount   AdminAccount? @relation(fields: [adminAccountId], references: [id], onDelete: SetNull)
  timestamp      DateTime      @default(now())
  details        Json?
}
